# 包含目录
firmware_incdirs = include_directories(
  'CubeMX/Core/Inc',
  'CMSIS/Include',
  'CMSIS/Device/ST/STM32H7xx/Include',
  'STM32H7xx_HAL_Driver/Inc',
  'STM32H7xx_HAL_Driver/Inc/Legacy',
)

# 源文件列表初始化
firmware_sources = files(
  './CubeMX/Core/Src/main.c',
  './CubeMX/Core/Src/stm32h7xx_hal_msp.c',
  './CubeMX/Core/Src/stm32h7xx_it.c',
