{
  "mesonbuild.configureOnOpen": false,
  "files.associations": {
    "*.json5": "jsonc",
    "*.inc": "shellscript",
    "*.h": "c"
  },
  "clangd.enable": true,
  "clangd.arguments": [
    "--query-driver=/usr/bin/arm-none-eabi-gcc",
    "--compile-commands-dir=/workspaces/build",
    "--clang-tidy"
  ],
  "clangd.path": "/opt/clangd/bin/clangd",
  "clang-tidy.buildPath": "/workspaces/build",
  "C_Cpp.default.compileCommands": "/workspaces/build/compile_commands.json",
  "C_Cpp.default.configurationProvider": "mesonbuild.mesonbuild"
}
